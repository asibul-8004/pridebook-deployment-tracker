{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/deployments.json",
      "destination": "/api/deployments"
    },
    {
      "source": "/api/deployments",
      "destination": "/api/deployments"
    },
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/db/deployments",
      "destination": "/api/db/deployments"
    },
    {
      "source": "/api/db/sync",
      "destination": "/api/db/sync"
    },
    {
      "source": "/api/deployments/history",
      "destination": "/api/deployments/history"
    },
    {
      "source": "/api/deployments/toggle-deployable",
      "destination": "/api/deployments/toggle-deployable"
    },
    {
      "source": "/release",
      "destination": "/release.html"
    },
    {
      "source": "/api/deploy/tags",
      "destination": "/api/deploy/tags"
    },
    {
      "source": "/api/deploy/trigger",
      "destination": "/api/deploy/trigger"
    },
    {
      "source": "/api/deploy/status",
      "destination": "/api/deploy/status"
    },
    {
      "source": "/api/deploy/recent",
      "destination": "/api/deploy/recent"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/deploy/cancel",
      "destination": "/api/deploy/cancel"
    },
    {
      "source": "/api/deploy/validate",
      "destination": "/api/deploy/validate"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/deployments.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
