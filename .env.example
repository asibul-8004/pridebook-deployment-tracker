# Pridebook Version Tracker - Environment Template
PORT=3000
SOURCE_MODE=github
GITHUB_REPO=your-org/your-frontend-repo
GITHUB_BRANCH=main
GITHUB_FRONTEND_REPO=your-org/your-frontend-repo
GITHUB_BACKEND_REPO=your-org/your-backend-repo
GITHUB_TOKEN=
DEPLOYMENTS_FILE=deployments.json

# Database Configuration (oracle or sqlite)
DB_TYPE=oracle
ORACLE_HOST=your_oracle_server_ip
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service_name
ORACLE_USER=your_db_username
ORACLE_PASSWORD=your_db_password
ORACLE_TABLE_NAME=SA_DEPLOYMENT_TRACKER
ORACLE_DTL_TABLE_NAME=SA_DEPLOYMENT_TRACKER_DTL

# Release Deployment Credentials
USERNAME=pridebook
PASSWORD=prideerp
